{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kokkai-watch",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    // UTC。省庁RSS: 毎時5分 / 衆議院の議案: 3時間ごと / 会議録: 6時間ごと
    // 変更したら src/collector/index.ts の CRON_TO_JOB も合わせる
    "crons": ["5 * * * *", "20 */3 * * *", "40 */6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kokkai-watch",
      // database_id は書かない。デプロイ時に Wrangler が database_name で検索し、なければ作成する
      "migrations_dir": "../../migrations"
    }
  ]
}
