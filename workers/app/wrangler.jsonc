{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kokkai-watch",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kokkai-watch",
      // database_id は書かない。デプロイ時に Wrangler が database_name で検索し、なければ作成する
      "migrations_dir": "../../migrations"
    }
  ]
}
